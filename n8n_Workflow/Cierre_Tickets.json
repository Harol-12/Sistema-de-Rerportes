      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT \n    t.id_ticket,\n    t.nombre_solicitante,\n    t.departamento,\n    t.categoria,\n    t.descripcion,\n    t.fecha_cierre,\n    COALESCE(tc.nombre, 'GIH') AS nombre_tecnico\nFROM tickets t\nLEFT JOIN tecnicos tc ON tc.id_tecnico = t.id_tecnico\nWHERE t.estado = 'Finalizado'\nORDER BY t.id_ticket DESC;",
        "options": {}
